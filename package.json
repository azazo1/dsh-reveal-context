{
  "name": "dsh-reveal-context",
  "version": "0.1.0",
  "description": "Show DSH's hidden injected-context rows (AGENTS.md notices, skill catalogs, recalled sessions, runtime snapshots) back in the Chat transcript, with a per-kind opt-out.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh-plugin.naming.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build:host": "tsdown --config tsdown.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "build": "pnpm run build:host && pnpm run build:client",
    "test": "vitest run",
    "check:client-entry": "node scripts/check-client-entry.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azazo1/dsh-reveal-context.git"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "packageManager": "pnpm@11.24.0",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4",
    "react": ">=18"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.1",
    "@deepseek-ai/schemastery": "~3.18.4",
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0",
    "vitest": "^4.1.8"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "web-ui",
    "conversation",
    "context-injection"
  ]
}
